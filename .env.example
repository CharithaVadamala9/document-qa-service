# Copy to .env and fill in. Never commit .env.
# Only OPENAI_API_KEY is required; every other value has a working default.

OPENAI_API_KEY=sk-your-key-here

# --- models ---------------------------------------------------------------
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VERIFY_NUMERIC_GROUNDING=true

# --- service --------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=json          # "console" for readable local output

# --- input limits ---------------------------------------------------------
MAX_FILE_SIZE_MB=20
MAX_QUESTIONS_FILE_KB=256
MAX_PDF_PAGES=300
MAX_QUESTIONS=50
MAX_QUESTION_CHARS=1000

# --- chunking and retrieval ----------------------------------------------
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=10
MMR_FETCH_K=40
MMR_LAMBDA=0.5

# --- concurrency and timeouts --------------------------------------------
MAX_CONCURRENT_QUESTIONS=5
MAX_CONCURRENT_REQUESTS=32
LLM_TIMEOUT_SECONDS=30
QUESTION_TIMEOUT_SECONDS=60
REQUEST_TIMEOUT_SECONDS=300

# Number of document indexes cached in memory. 0 disables caching.
DOCUMENT_CACHE_SIZE=32
